{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Second Brain Block",
  "type": "object",
  "required": [
    "type",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "page_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_block_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "type": {
      "enum": [
        "paragraph",
        "heading",
        "bulleted_list_item",
        "numbered_list_item",
        "todo",
        "quote",
        "code",
        "divider",
        "callout",
        "link",
        "image",
        "file",
        "child_page"
      ]
    },
    "position": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "content": {
      "type": "object"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "heading"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "level",
              "rich_text"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "rich_text": {
                "$ref": "#/$defs/richText"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "paragraph",
              "bulleted_list_item",
              "numbered_list_item",
              "quote"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "rich_text"
            ],
            "properties": {
              "rich_text": {
                "$ref": "#/$defs/richText"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "todo"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "checked",
              "rich_text"
            ],
            "properties": {
              "checked": {
                "type": "boolean"
              },
              "rich_text": {
                "$ref": "#/$defs/richText"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "code"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "divider"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "callout"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "rich_text"
            ],
            "properties": {
              "emoji": {
                "type": "string"
              },
              "rich_text": {
                "$ref": "#/$defs/richText"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "link"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "url",
              "label"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "image",
              "file"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "attachment_id"
            ],
            "properties": {
              "attachment_id": {
                "type": "string",
                "format": "uuid"
              },
              "alt": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "child_page"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "page_id"
            ],
            "properties": {
              "page_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "richText": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "marks"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "marks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "bold",
                        "italic",
                        "underline",
                        "strike"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "url"
                  ],
                  "properties": {
                    "type": {
                      "const": "link"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
