{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Second Brain MCP tool catalog",
  "tools": [
    {
      "name": "search_pages",
      "permission": "read",
      "input": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500
          },
          "tag_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_page",
      "permission": "read",
      "input": {
        "type": "object",
        "required": [
          "page_id"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "format": "uuid"
          },
          "include_blocks": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    {
      "name": "list_children",
      "permission": "read",
      "input": {
        "type": "object",
        "properties": {
          "parent_page_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "create_page",
      "permission": "create",
      "input": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "parent_page_id": {
            "type": "string",
            "format": "uuid"
          },
          "icon": {
            "type": "string",
            "maxLength": 32
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "update_page",
      "permission": "update",
      "input": {
        "type": "object",
        "required": [
          "page_id",
          "expected_revision"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    {
      "name": "append_blocks",
      "permission": "update",
      "input": {
        "type": "object",
        "required": [
          "page_id",
          "blocks",
          "idempotency_key"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "format": "uuid"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "update_block",
      "permission": "update",
      "input": {
        "type": "object",
        "required": [
          "block_id",
          "content",
          "expected_revision"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "object"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    {
      "name": "move_block",
      "permission": "update",
      "input": {
        "type": "object",
        "required": [
          "block_id",
          "target_page_id",
          "position",
          "expected_revision"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "format": "uuid"
          },
          "target_page_id": {
            "type": "string",
            "format": "uuid"
          },
          "target_parent_block_id": {
            "type": "string",
            "format": "uuid"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "name": "add_tags",
      "permission": "update",
      "input": {
        "type": "object",
        "required": [
          "page_id",
          "tags"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "format": "uuid"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    {
      "name": "archive_page",
      "permission": "archive",
      "input": {
        "type": "object",
        "required": [
          "page_id",
          "expected_revision"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "include_descendants": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  ]
}
